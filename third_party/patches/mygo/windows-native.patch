+// The labels of a real popup menu fit in the items Windows lays out. It
+// widens owner-drawn items by an amount of its own, which measureItem
+// takes off: taking off more cut the end of the widest label, as the right
+// edge of 设 in 保存为新预设 on Chinese Windows.
+func TestOneSubPopupItemWidth(t *testing.T) {
+	if !fluentMenus() {
+		t.Skip("Windows 10 draws the items of its menus")
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	labels := []string{"保存为新预设", "重命名", "删除", "打开 OneSub", "Save as new preset", "Quit"}
+	var (
+		b     Backend
+		menu  uintptr
+		width int32
+	)
+	procGetMenuItemRect := user32.NewProc("GetMenuItemRect")
+	proc := syscall.NewCallback(func(hwnd, m, wp, lp uintptr) uintptr {
+		switch uint32(m) {
+		case wmMeasureItem, wmDrawItem:
+			if r, ok := b.menuItemMessage(hwnd, uint32(m), wp, lp); ok {
+				return r
+			}
+		case wmTimer:
+			// The menu shows: read its first item, then close it.
+			procKillTimer.Call(hwnd, wp)
+			var r rect
+			if ok, _, _ := procGetMenuItemRect.Call(0, menu, 0, uintptr(unsafe.Pointer(&r))); ok != 0 {
+				width = r.Right - r.Left
+			}
+			procEndMenu.Call()
+			return 0
+		}
+		r, _, _ := procDefWindowProcW.Call(hwnd, m, wp, lp)
+		return r
+	})
+	instance, _, _ := procGetModuleHandleW.Call(0)
+	class := u16("OneSubPopupItemWidthTest")
+	wc := wndClassEx{WndProc: proc, Instance: instance, ClassName: class}
+	wc.Size = uint32(unsafe.Sizeof(wc))
+	procRegisterClassExW.Call(uintptr(unsafe.Pointer(&wc)))
+	hwnd, _, _ := procCreateWindowExW.Call(0, uintptr(unsafe.Pointer(class)), 0, wsPopup, 0, 0, 0, 0, 0, 0, instance, 0)
+	if hwnd == 0 {
+		t.Fatal("no owner window")
+	}
+	defer procDestroyWindow.Call(hwnd)
+	dpi := dpiOf(hwnd)
+	defer b.dropMenuFonts()
+	f := b.menuFace(dpi)
+	dc, _, _ := procGetDC.Call(0)
+	defer procReleaseDC.Call(0, dc)
+	need := int32(0)
+	for _, label := range labels {
+		need = max(need, toPx(menuInset+menuPadding, dpi)*2+textWidth(dc, f.text, label))
+	}
+	for pass := 0; pass < 2; pass++ {
+		// Windows caches a handle's measured widths. Rebuild the popup as
+		// the application does, retaining only the backend's learned extra.
+		menu, _, _ = procCreatePopupMenu.Call()
+		owner := b.menus.newOwner()
+		for i, label := range labels {
+			procAppendMenuW.Call(menu, mfString, uintptr(i+1), uintptr(unsafe.Pointer(u16(label))))
+			ownerDraw(menu, i, 0, b.menus.addLook(&menuLook{label: label, owner: owner, menu: menu, pos: i, dpi: dpi, first: i == 0, last: i == len(labels)-1}))
+		}
+		width = 0
+		procSetTimer.Call(hwnd, 1, 200, 0)
+		procTrackPopupMenuEx.Call(menu, tpmReturnCmd|tpmRightButton, 100, 100, hwnd, 0)
+		procDestroyMenu.Call(menu)
+		b.menus.drop(owner)
+		// Upstream v0.7.4 learns the platform's extra width from the first
+		// visible menu. Both must fit; the second must use that learned width.
+		if width < need || pass > 0 && width > need+toPx(2, dpi) {
+			t.Fatalf("popup %d: items are %d pixels wide; the widest label needs %d", pass+1, width, need)
+		}
+	}
+}
+
+// A hidden tray owner has no useful per-monitor DPI. Measurement and paint
+// must use the monitor recorded when the popup was built.
+func TestOneSubPopupMonitorDPI(t *testing.T) {
+	for _, dpi := range []int{96, 144, 192} {
+		l := menuLook{dpi: dpi}
+		if got := l.popupDPI(0); got != dpi {
+			t.Fatalf("DPI = %d, want %d", got, dpi)
+		}
+	}
+}
+
+// Use actual GDI measurements, including Chinese fallback glyphs. Large
+// accessibility fonts must enlarge the row instead of being clipped to 32 DIP.
+func TestOneSubPopupFontBounds(t *testing.T) {
+	for _, dpi := range []int{96, 144, 192} {
+		for _, size := range []int{14, 48, 64} {
+			font := createFont(-toPx(size, dpi), "Microsoft YaHei UI")
+			if font == 0 {
+				t.Fatal("font unavailable")
+			}
+			b := Backend{menuFonts: map[int]menuFonts{dpi: {text: font}}}
+			l := &menuLook{label: "打开 OneSub · 退出", dpi: dpi, first: true, last: true}
+			var measured measureItemStruct
+			b.measureItem(0, l, &measured)
+			dc, _, _ := procGetDC.Call(0)
+			_, h := textSize(dc, font, l.label)
+			procReleaseDC.Call(0, dc)
+			top, bottom := l.padding(dpi)
+			if int32(measured.ItemHeight)-top-bottom < h+toPx(menuInset*2, dpi) {
+				t.Fatalf("DPI %d size %d: row %d clips text %d", dpi, size, measured.ItemHeight, h)
+			}
+			b.dropMenuFonts()
+		}
+	}
+}
+
+// A real native surface must request a composition swap chain before any
+// web view exists. Creating an HWND flip chain first leaves an old UI plane.
+func TestOneSubNativeSurfaceStartsComposed(t *testing.T) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	hwnd, _, _ := procCreateWindowExW.Call(0, uintptr(unsafe.Pointer(u16("STATIC"))), 0, wsPopup, 0, 0, 320, 180, 0, 0, 0, 0)
+	if hwnd == 0 {
+		t.Fatal("native test window unavailable")
+	}
+	defer procDestroyWindow.Call(hwnd)
+	s := &surface{w: &window{}, hwnd: hwnd}
+	if !s.Native().Composed {
+		t.Fatal("first UI frame would create an HWND swap chain before the media layer")
+	}
+}
