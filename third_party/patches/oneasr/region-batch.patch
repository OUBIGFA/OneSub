+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RegionBatch {
+    version: u32,
+    regions: Vec<RegionFile>,
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RegionFile {
+    input: PathBuf,
+    output: PathBuf,
+    words_json: PathBuf,
+}
+
+fn cmd_region_batch(path: &Path, settings: &Settings, data_root: &Path) -> Result<(), i32> {
+    let fail = |detail: String| {
+        eprintln!("{}", i18n::cli_region_batch_error(detail));
+        1
+    };
+    let metadata = std::fs::metadata(path).map_err(|error| fail(error.to_string()))?;
+    if metadata.len() > 8 * 1024 * 1024 {
+        return Err(fail(i18n::t(i18n::ERR_REGION_BATCH_INVALID).into()));
+    }
+    let raw = std::fs::read(path).map_err(|error| fail(error.to_string()))?;
+    let batch: RegionBatch =
+        serde_json::from_slice(&raw).map_err(|error| fail(error.to_string()))?;
+    if batch.version != 1
+        || batch.regions.is_empty()
+        || !settings.output_srt
+        || settings.output_txt
+        || settings.output_ass
+    {
+        return Err(fail(i18n::t(i18n::ERR_REGION_BATCH_INVALID).into()));
+    }
+    let mut stems = std::collections::HashSet::new();
+    let mut inputs = Vec::with_capacity(batch.regions.len());
+    for region in &batch.regions {
+        let name = region
+            .input
+            .file_name()
+            .ok_or_else(|| fail(i18n::t(i18n::ERR_REGION_BATCH_INVALID).into()))?;
+        let stem = region
+            .input
+            .file_stem()
+            .ok_or_else(|| fail(i18n::t(i18n::ERR_REGION_BATCH_INVALID).into()))?;
+        if !region.input.is_file() || !stems.insert(stem.to_owned()) {
+            return Err(fail(i18n::t(i18n::ERR_REGION_BATCH_INVALID).into()));
+        }
+        inputs.push(oneasr_core::BatchInput {
+            input: region.input.clone(),
+            media_name: name.to_string_lossy().into_owned(),
+            export: ProcessExportOptions {
+                words_json: Some(region.words_json.clone()),
+                timeline_json: false,
+            },
+        });
+    }
+    let started = Instant::now();
+    let outputs = oneasr_core::process_media_batch_with_export(
+        &inputs,
+        settings,
+        data_root,
+        |region, total, update| {
+            eprintln!("[region] {region}/{total}");
+            if let Some(warning) = &update.warning {
+                eprintln!("{}", i18n::cli_warn(warning));
+            }
+            eprintln!("{}", i18n::cli_stage(&update.label(i18n::ui_lang())));
+        },
+    )
+    .map_err(|error| fail(error.to_string()))?;
+    for (region, output) in batch.regions.iter().zip(outputs) {
+        if !region.words_json.is_file() {
+            return Err(fail(i18n::cli_input_not_found(&region.words_json)));
+        }
+        if region.output != output {
+            std::fs::copy(&output, &region.output).map_err(|error| fail(error.to_string()))?;
+        }
+    }
+    eprintln!(
+        "[region-batch] completed={} elapsed_ms={}",
+        batch.regions.len(),
+        started.elapsed().as_millis()
+    );
+    Ok(())
+}
 
