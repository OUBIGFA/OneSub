@@ -0,0 +1,126 @@
+package ui
+
+import (
+	"math"
+	"testing"
+
+	"github.com/egoist/mygo/internal/scene"
+)
+
+// 0.8.1 correctly gives a self-labelled control's field a group name. The
+// headless click guard must distinguish that group from a modal's backdrop.
+func TestOneSubNamedModalFieldTargetsItsControl(t *testing.T) {
+	open, disabled := true, false
+	value := "before"
+	tt := NewTester(func(c *Context) {
+		Modal(c, &open, func() {
+			Field(c, "Address", func() { TextInput(c, &value).Label("Address").Disabled(disabled) }).Width(320)
+		})
+	}, 600, 400)
+	if err := tt.Click("Address"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Key(Cmd, KeyA)
+	tt.Type("after")
+	if value != "after" || !open {
+		t.Fatal("field click did not reach the input", value, open)
+	}
+	disabled = true
+	tt.Frame()
+	if err := tt.Click("Address"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Type("ignored")
+	if value != "after" || !open {
+		t.Fatal("disabled field accepted input or dismissed the dialog", value, open)
+	}
+}
+
+// Base-menu tests use real pointer/keyboard actions, not command injection.
+func TestOneSubBaseMenuTesterUsesActualInput(t *testing.T) {
+	open, choice := false, ""
+	tt := NewTester(func(c *Context) {
+		m := MenuBase(c, &open)
+		m.Trigger.Label("Actions").Size(100, 32)
+		m.Popup(func(panel Element) {
+			panel.Width(200).Padding(4)
+			if m.Item().Label("First").Height(32).Clicked() {
+				choice = "First"
+			}
+			Box(c).Height(1).Role(RoleSeparator)
+			m.CheckItem(true).Label("Unavailable").Disabled(true).Height(32)
+			if m.Item().Label("Last").Height(32).Clicked() {
+				choice = "Last"
+			}
+		})
+	}, 400, 400)
+	if err := tt.Click("Actions"); err != nil {
+		t.Fatal(err)
+	}
+	labels := tt.Menu()
+	if len(labels) != 4 || labels[0] != "First" || labels[1] != "-" || labels[3] != "Last" {
+		t.Fatal(labels)
+	}
+	if err := tt.ChooseMenuItem("Unavailable"); err == nil || choice != "" || !open {
+		t.Fatal("disabled item ran", err, choice, open)
+	}
+	if err := tt.ChooseMenuItem("Last"); err != nil || choice != "Last" || open {
+		t.Fatal("keyboard menu selection failed", err, choice, open)
+	}
+	if err := tt.Click("Actions"); err != nil {
+		t.Fatal(err)
+	}
+	tt.CloseMenu()
+	if open || len(tt.Menu()) != 0 {
+		t.Fatal("Escape did not dismiss the menu")
+	}
+}
+
+// NoWrap is an explicit opt-out from paint-only elision. Timecode callers
+// separately reserve enough width for their full formatted value and padding.
+func TestOneSubNoWrapInputNeverBuildsEllipsis(t *testing.T) {
+	value := "100:23:45.678"
+	var input *node
+	tt := coreNewTester(func(c *context) {
+		input = coreTextInput(c, &value).NoWrap().Width(50)
+	}, 300, 100)
+	tt.Frame()
+	if input.st.editor.elidedLayout != nil || input.inputPaintLayout(20) != input.st.editor.layout {
+		t.Fatal("NoWrap timecode was elided")
+	}
+}
+
+// One raw frame per resize, deliberately without Tester's settling loop:
+// native placement and the painted hole must agree immediately at any aspect.
+func TestOneSubContainedWebViewUsesCurrentFrame(t *testing.T) {
+	page := &testWebView{"video"}
+	aspect := float32(16.0 / 9)
+	tt := coreNewTester(func(c *context) {
+		coreColumn(c).Fill().Background(RGB(0, 0, 0)).Children(func() {
+			coreWebView(c, page).Fill().MinHeight(0).AspectRatio(aspect).Fit(Contain)
+		})
+	}, 900, 600)
+	for _, ratio := range []float32{16.0 / 9, 9.0 / 16, 4.0 / 3} {
+		aspect = ratio
+		for _, size := range [][2]float32{{1200, 400}, {500, 900}, {900, 500}, {700, 650}} {
+			tt.h.w, tt.h.h = size[0], size[1]
+			tt.rt.runFrame()
+			place, ok := placed(tt, page)
+			if !ok || math.Abs(place.frame.W/place.frame.H-float64(aspect)) > .01 || place.frame.X < 0 || place.frame.Y < 0 || place.frame.X+place.frame.W > float64(size[0])+1 || place.frame.Y+place.frame.H > float64(size[1])+1 {
+				t.Fatal("stale or distorted native viewport", size, place.frame)
+			}
+			found := false
+			for _, op := range tt.rt.scene.Ops {
+				if op.Kind == scene.OpHole {
+					found = true
+					if math.Abs(float64(op.Rect.X)-place.frame.X) > 1 || math.Abs(float64(op.Rect.Y)-place.frame.Y) > 1 || math.Abs(float64(op.Rect.W)-place.frame.W) > 1 || math.Abs(float64(op.Rect.H)-place.frame.H) > 1 {
+						t.Fatal("hole and native video came from different frames", op.Rect, place.frame)
+					}
+				}
+			}
+			if !found {
+				t.Fatal("media hole missing")
+			}
+		}
+	}
+}
