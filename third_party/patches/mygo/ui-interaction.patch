+func TestOneSubRowScrollUsesNativeMotion(t *testing.T) {
+	for _, reduce := range []bool{false, true} {
+		var state ListState
+		jump, glide := 60, -1
+		tt := coreNewTester(func(c *context) {
+			coreTable(c, &state, []TableColumn{{Title: "Subtitle"}}, 200, func(row, col int) {
+				coreText(c, fmt.Sprint("Row ", row)).Height(float32(32 + (row%3)*12))
+			}).Fill()
+			if jump >= 0 {
+				state.ScrollTo(jump, Center)
+				jump = -1
+			}
+			if glide >= 0 {
+				state.ScrollToAnimated(glide, Center, Animation{Duration: 220 * time.Millisecond, Ease: EaseOut})
+				glide = -1
+			}
+		}, 500, 400)
+		tt.SetPreferences(Preferences{ReduceMotion: reduce})
+		tt.Frame()
+		before := state.wroteY
+		glide = 61
+		tt.Frame()
+		tt.Advance(55 * time.Millisecond)
+		middle := state.wroteY
+		tt.Advance(300 * time.Millisecond)
+		after := state.wroteY
+		if after <= before || (!reduce && !(middle > before && middle < after)) || reduce && math.Abs(middle-after) > .5 {
+			t.Fatal("row locate did not honor native motion", reduce, before, middle, after)
+		}
+		glide = 62
+		tt.Frame()
+		tt.Advance(40 * time.Millisecond)
+		jump = 0
+		tt.Frame()
+		tt.Advance(time.Second)
+		if first, _ := state.Visible(); first != 0 || state.Scrolling() {
+			t.Fatal("edge navigation did not cancel motion", first)
+		}
+	}
+}
