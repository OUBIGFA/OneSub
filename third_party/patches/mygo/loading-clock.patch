 // timer is how long an indicator has run: since start, or held while
 // paused.
 type timer struct {
-	start  time.Time
-	held   time.Duration
-	paused bool
+	start        time.Time
+	held         time.Duration
+	paused       bool
+	pauseAt      time.Time
+	stopDuration time.Duration
 	// sh is the shape the indicator draws with, its storage kept from
 	// frame to frame.
 	sh shape
+}
+
+// elapsed evaluates the clock at an absolute time, independent of paint rate.
+// Resuming during a gradual stop continues from the currently visible phase.
+func (k *timer) elapsed(now time.Time) time.Duration {
+	if !k.paused {
+		return now.Sub(k.start)
+	}
+	if k.stopDuration <= 0 {
+		return k.held
+	}
+	d := min(max(now.Sub(k.pauseAt), 0), k.stopDuration)
+	return k.held + time.Duration(float64(d)*(1-float64(d)/(2*float64(k.stopDuration))))
 }
 
