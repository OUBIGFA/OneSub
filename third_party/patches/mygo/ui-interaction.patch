+// Keep the complete layout for caret hit testing, selection, IME and access.
+// Only an unfocused single-line field's painted text is elided, using the
+// same shaper as Text.SingleLine. Cache it on the editor, not globally.
+func (e *node) inputPaintLayout(width float32) *text.Layout {
+	ed := e.st.editor
+	if e.noWrap || e.Focused() || ed.multiline || ed.layout == nil || ed.layout.Width <= width {
+		ed.elidedLayout = nil
+		return ed.layout
+	}
+	params := e.inputParams(width)
+	params.Width, params.MaxLines = width, 1
+	gen := ed.sys.Generation()
+	if ed.elidedLayout == nil || ed.elidedLayout.Params != params || ed.elidedGeneration != gen {
+		ed.elidedLayout = ed.sys.Shape(params)
+		ed.elidedGeneration = gen
+	}
+	return ed.elidedLayout
+}
