+// Normal Frame settles up to 20 frames; first-frame layout regressions must
+// observe the first presentation before that loop can conceal a jump.
+func (t *Tester) FrameOnce() {
+	t.frameAt = t.Now()
+	t.h.requested.Store(false)
+	t.h.invalidated.Store(false)
+	t.runLater()
+	t.rt.runFrame()
+}
