+func TestOneSubCompositePlaceholderAndElision(t *testing.T) {
+	for _, kind := range []string{"search", "combobox", "tokens", "autocomplete"} {
+		t.Run(kind, func(t *testing.T) {
+			value, hint := "", "搜索（1-361）"
+			var tokens []string
+			var input *node
+			tt := coreNewTester(func(c *context) {
+				var field *node
+				switch kind {
+				case "search":
+					field = coreSearchField(c, &value)
+				case "combobox":
+					field = coreCombobox(c, &value, []string{"Choice"})
+				case "tokens":
+					field = coreTokenField(c, &tokens, nil)
+				case "autocomplete":
+					field = coreAutocomplete(c, &value, nil)
+				}
+				field.Placeholder(hint).Label("Field").Width(220)
+				input = field
+				if input.st.editor == nil {
+					input = fieldControl(field)
+				}
+			}, 500, 180)
+			for _, text := range []string{"搜索（1-361）", "搜索（0-0）", "Search (1-20000)"} {
+				hint = text
+				tt.Frame()
+				tt.Image()
+				layout := input.c.rt.text.Layout(input.placeholderParams(input.contentBox().W))
+				if layout.Params.Text != hint || layout.Truncated || value != "" {
+					t.Fatal("composite input did not display the current placeholder", layout.Params.Text, hint)
+				}
+			}
+			hint = "Choose or enter a model name " + strings.Repeat("long ", 20)
+			tt.Frame()
+			tt.Image()
+			layout := input.c.rt.text.Layout(input.placeholderParams(input.contentBox().W))
+			if !layout.Truncated || len(layout.Lines) != 1 || layout.Width > input.contentBox().W+1 {
+				t.Fatal("long placeholder was clipped without an ellipsis", layout.Truncated, layout.Width)
+			}
+			if kind == "search" {
+				tt.Click("Field")
+				tt.Type("needle")
+				if value != "needle" {
+					t.Fatal("placeholder changed the search value", value)
+				}
+				tt.Key(0, KeyEscape)
+				if value != "" || input.st.editor.placeholder != hint {
+					t.Fatal("clearing search lost its placeholder")
+				}
+			}
+		})
+	}
+}
