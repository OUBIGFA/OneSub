+// Both edges are measured before the native scroll glide starts. Even a long
+// virtual table traverses only the landing viewport, never estimated whole-list
+// offsets; the last row may be taller than the viewport itself.
+func TestOneSubEdgeScrollUsesNativeLanding(t *testing.T) {
+	for _, toEnd := range []bool{false, true} {
+		for _, reduce := range []bool{false, true} {
+			for _, tallLast := range []bool{false, true} {
+				t.Run(fmt.Sprintf("end=%t/reduce=%t/tall=%t", toEnd, reduce, tallLast), func(t *testing.T) {
+					selected := 11
+					state := ListState{Selected: &selected}
+					const count = 20000
+					jump, edge := count/2, -1
+					animation := Animation{Duration: 420 * time.Millisecond, Ease: CubicBezier(0.22, 1, 0.36, 1)}
+					tt := coreNewTester(func(c *context) {
+						coreTable(c, &state, []TableColumn{{Title: "Subtitle"}}, count, func(row, col int) {
+							height := float32(32 + row%3*12)
+							if tallLast && row == count-1 {
+								height = 720
+							}
+							coreText(c, fmt.Sprint("Row ", row)).Height(height)
+						}).Fill()
+						if jump >= 0 {
+							state.ScrollTo(jump, Center)
+							jump = -1
+						}
+						if edge >= 0 {
+							state.ScrollToEdgeAnimated(edge == 1, animation)
+							edge = -1
+						}
+					}, 500, 400)
+					tt.SetPreferences(Preferences{ReduceMotion: reduce})
+					edge = 0
+					if toEnd {
+						edge = 1
+					}
+					tt.Frame()
+					positions := []float64{state.wroteY}
+					for range 4 {
+						tt.Advance(animation.Duration / 4)
+						positions = append(positions, state.wroteY)
+					}
+					tt.Advance(20 * time.Millisecond)
+					first, last := state.Visible()
+					if state.Scrolling() || selected != 11 || toEnd && (!state.AtEnd() || last != count-1) || !toEnd && first != 0 {
+						t.Fatal("edge glide did not settle without changing selection", first, last, selected)
+					}
+					travel := math.Abs(positions[4] - positions[0])
+					if reduce {
+						if travel > .5 {
+							t.Fatal("reduced motion still animated", positions)
+						}
+						return
+					}
+					if travel <= .5 || travel > float64(state.frame.e.st.h)+.5 {
+						t.Fatal("edge landing was instant or crossed more than one viewport", positions)
+					}
+					previous := travel
+					for i := 1; i < len(positions); i++ {
+						step := math.Abs(positions[i] - positions[i-1])
+						if step <= 0 || step >= previous {
+							t.Fatal("edge landing did not steadily decelerate", positions)
+						}
+						previous = step
+					}
+				})
+			}
+		}
+	}
+}
