@@ -0,0 +1,48 @@
+package loading
+
+import (
+	"testing"
+	"time"
+)
+
+func TestOneSubGradualPauseClock(t *testing.T) {
+	now := time.Unix(100, 0)
+	k := timer{paused: true, held: 2 * time.Second, pauseAt: now, stopDuration: time.Second}
+	for _, test := range []struct{ at, want time.Duration }{
+		{0, 2 * time.Second}, {500 * time.Millisecond, 2375 * time.Millisecond},
+		{time.Second, 2500 * time.Millisecond}, {5 * time.Second, 2500 * time.Millisecond},
+	} {
+		if got := k.elapsed(now.Add(test.at)); got != test.want {
+			t.Fatal(test.at, got, test.want)
+		}
+	}
+}
+
+func TestOneSubBlocksGradualPauseAndResume(t *testing.T) {
+	o := Options{Duration: time.Second, StopDuration: 500 * time.Millisecond}
+	tt := tester(Spinner{"Blocks", Blocks}, &o)
+	tt.Advance(300 * time.Millisecond)
+	o.Paused = true
+	start := at(tt)
+	tt.Advance(250 * time.Millisecond)
+	if !differ(start, at(tt)) || !tt.FramePending() {
+		t.Fatal("gradual pause stopped immediately")
+	}
+	tt.Advance(250 * time.Millisecond)
+	held := at(tt)
+	if tt.FramePending() {
+		t.Fatal("settled blocks keep requesting frames")
+	}
+	tt.Advance(time.Second)
+	if differ(held, at(tt)) {
+		t.Fatal("blocks still move after settling")
+	}
+	o.Paused = false
+	if differ(held, at(tt)) {
+		t.Fatal("resuming jumps to another phase")
+	}
+	tt.Advance(150 * time.Millisecond)
+	if !differ(held, at(tt)) {
+		t.Fatal("resuming did not restart the animation")
+	}
+}
