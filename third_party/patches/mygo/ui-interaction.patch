+
+// ScrollToAnimated glides a measured, nearby row to align. Call it from the
+// view after building the list. Distant or unmeasured targets use ScrollTo:
+// traversing thousands of unseen rows would hide the destination and depend
+// on estimated heights. Native ScrollState owns easing and reduced motion.
+func (s *ListState) ScrollToAnimated(row int, align Align, animation Animation) {
+	f := &s.frame
+	if f.c == nil || !f.c.rt.inFrame || f.frame != f.c.rt.frame || f.pass != f.c.rt.pass || !s.laidOut || row < s.first || row > s.last || s.Header != nil {
+		s.ScrollTo(row, align)
+		return
+	}
+	e := f.e
+	y := float32(s.padTop + s.heights.top(row, s.gap))
+	height := float32(s.heights.height(row))
+	switch align {
+	case Center:
+		y -= (e.st.h - height) / 2
+	case End:
+		y -= e.st.h - height - e.pad[2] - e.border[2]
+	default:
+		y -= float32(s.padTop)
+	}
+	if s.scrollMotion == nil {
+		s.scrollMotion = &ScrollState{X: float32(e.st.scrollX), Y: float32(e.st.scrollY), MaxX: float32(max(0, e.st.contentW-float64(e.st.w))), MaxY: float32(max(0, e.st.contentH-float64(e.st.h)))}
+	}
+	s.req, s.scrolled = listRequest{}, true
+	s.scrollMotion.ScrollTo(s.scrollMotion.X, y, animation)
+	e.TrackScroll(s.scrollMotion)
+	e.c.rt.requestFrame()
+}
