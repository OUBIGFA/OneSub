+package ui
+
+import (
+	"fmt"
+	"math"
+	"strings"
+	"testing"
+	"time"
+)
+
+// Elision must never become a shortened value or a different editor. Exercise
+// native pointer selection, keyboard editing, masking and a second blur.
+func TestOneSubInputElisionKeepsEditing(t *testing.T) {
+	for _, password := range []bool{false, true} {
+		value := "https://example.com/" + strings.Repeat("长路径/", 25) + "endpoint"
+		original := value
+		var input *node
+		tt := coreNewTester(func(c *context) {
+			input = coreTextInput(c, &value).Width(180).Label("Address")
+			if password {
+				input.Password()
+			}
+		}, 600, 160)
+		tt.Image()
+		ed := input.st.editor
+		if ed.elidedLayout == nil || !ed.elidedLayout.Truncated || ed.layout.Truncated || value != original {
+			t.Fatal("blurred input did not elide only its display", password)
+		}
+		if password && strings.Contains(ed.elidedLayout.Params.Text, "example") {
+			t.Fatal("password exposed through elision")
+		}
+		if err := tt.Click("Address"); err != nil {
+			t.Fatal(err)
+		}
+		tt.Key(0, KeyEnd)
+		tt.Image()
+		if ed.elidedLayout != nil || ed.scrollX <= 0 {
+			t.Fatal("focused input no longer scrolls to its caret")
+		}
+		tt.Type("-edited")
+		if value != original+"-edited" {
+			t.Fatal("tail edit replaced the hidden text", value)
+		}
+		tt.Key(0, KeyHome)
+		r, _ := tt.Find("Address")
+		tt.Press(r.X+12, r.Y+r.H/2)
+		tt.Move(r.X+r.W+400, r.Y+r.H/2)
+		for range 20 {
+			tt.Advance(100 * time.Millisecond)
+		}
+		tt.Release(r.X+r.W+400, r.Y+r.H/2)
+		if ed.scrollX <= 0 || ed.caret <= 20 {
+			t.Fatal("drag selection did not reveal text beyond the field", ed.scrollX, ed.caret)
+		}
+		tt.ClickAt(550, 120)
+		tt.Image()
+		if ed.elidedLayout == nil || !ed.elidedLayout.Truncated || value != original+"-edited" {
+			t.Fatal("blur changed the full value")
+		}
+	}
+}
