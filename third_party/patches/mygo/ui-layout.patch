+// webViewBox applies native containment to this frame's content box. A caller
+// must not size a media view from Bounds(), which belongs to the previous frame.
+// Placement and the transparency hole must use the very same rectangle.
+func (e *node) webViewBox() Rect {
+	box := e.contentBox()
+	if e.fit == Contain && e.aspect > 0 {
+		w := min(box.W, box.H*e.aspect)
+		h := w / e.aspect
+		box.X += (box.W - w) / 2
+		box.Y += (box.H - h) / 2
+		box.W, box.H = w, h
+	}
+	return box
+}
