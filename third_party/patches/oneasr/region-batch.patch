+/// Process independent speech regions without joining their audio or retaining both GPU models.
+/// Region zero reports shared model loading; other progress uses one-based input indices.
+pub fn process_media_batch_with_export<'a>(
+    inputs: &[BatchInput],
+    settings: &Settings,
+    data_root: &Path,
+    on_stage: impl FnMut(usize, usize, StageUpdate) + Send + 'a,
+) -> Result<Vec<PathBuf>, AsrError> {
+    let provider = crate::engine::local::LocalEngineProvider::from_settings(settings)
+        .map_err(|error| AsrError::Other(error.message().to_string()))?;
+    process_media_batch_with_provider(inputs, settings, data_root, &provider, on_stage)
+}
