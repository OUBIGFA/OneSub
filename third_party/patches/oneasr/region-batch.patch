+/// The batch pipeline with an explicit provider for lifecycle and output regression tests.
+pub fn process_media_batch_with_provider<'a>(
+    inputs: &[BatchInput],
+    settings: &Settings,
+    data_root: &Path,
+    provider: &dyn EngineProvider,
+    mut on_stage: impl FnMut(usize, usize, StageUpdate) + Send + 'a,
+) -> Result<Vec<PathBuf>, AsrError> {
+    if inputs.is_empty() {
+        return Err(AsrError::Other(
+            i18n::t(i18n::ERR_REGION_BATCH_EMPTY).into(),
+        ));
+    }
+    check_asr_model_dir(&settings.asr_model_dir)?;
+    let align_needed = inputs
+        .iter()
+        .any(|input| needs_alignment(settings, &input.export));
+    if align_needed {
+        check_aligner_model_dir(&settings.aligner_model_dir)?;
+    }
+    let active = Arc::new(AtomicUsize::new(0));
+    let progress_active = Arc::clone(&active);
+    let total = inputs.len();
+    let pipeline = Pipeline::new(settings, provider, move |update| {
+        on_stage(progress_active.load(Ordering::Relaxed), total, update);
+    });
+    let mut prepared = Vec::with_capacity(total);
+    for (index, input) in inputs.iter().enumerate() {
+        active.store(index + 1, Ordering::Relaxed);
+        let converted = pipeline.stage_prepare(&input.input, data_root)?;
+        let vad = pipeline.stage_vad_plan(&converted)?;
+        let contexts = pipeline.stage_rough_transcribe(&converted, &vad)?;
+        prepared.push(PreparedInput {
+            converted,
+            vad,
+            contexts,
+        });
+    }
+    let transcripts = {
+        active.store(0, Ordering::Relaxed);
+        pipeline.emit(StageUpdate::new(AsrStage::LoadingAsr));
+        let engine = provider
+            .load_asr()
+            .map_err(|error| AsrError::LoadAsr(error.message().to_string()))?;
+        let mut transcripts = Vec::with_capacity(total);
+        for (index, input) in prepared.iter().enumerate() {
+            active.store(index + 1, Ordering::Relaxed);
+            transcripts.push(pipeline.transcribe_with(
+                engine.as_ref(),
+                &input.converted,
+                &input.vad,
+                input.contexts.as_deref(),
+            )?);
+        }
+        transcripts
+    };
+    if !align_needed {
+        return inputs
+            .iter()
+            .zip(&transcripts)
+            .enumerate()
+            .map(|(index, (input, transcript))| {
+                active.store(index + 1, Ordering::Relaxed);
+                pipeline.stage_export_txt_only(
+                    &input.input,
+                    &input.media_name,
+                    pipeline.txt_body(transcript),
+                )
+            })
+            .collect();
+    }
+    let aligned = {
+        active.store(0, Ordering::Relaxed);
+        pipeline.emit(StageUpdate::new(AsrStage::LoadingAligner));
+        let engine = provider
+            .load_aligner()
+            .map_err(|error| AsrError::LoadAligner(error.message().to_string()))?;
+        let mut aligned = Vec::with_capacity(total);
+        for (index, (input, transcript)) in prepared.iter().zip(&transcripts).enumerate() {
+            active.store(index + 1, Ordering::Relaxed);
+            aligned.push(pipeline.align_with(
+                engine.as_ref(),
+                &input.converted,
+                &input.vad,
+                transcript,
+            )?);
+        }
+        aligned
+    };
+    let mut outputs = Vec::with_capacity(total);
+    for (index, alignment) in aligned.into_iter().enumerate() {
+        active.store(index + 1, Ordering::Relaxed);
+        let input = &inputs[index];
+        outputs.push(pipeline.stage_export(
+            ExportInput {
+                input: &input.input,
+                media_name: &input.media_name,
+                speech_segments: prepared[index].vad.speech_segments.clone(),
+                transcript: None,
+                txt_body: pipeline.txt_body(&transcripts[index]),
+            },
+            alignment,
+            input.export.clone(),
+        )?);
+    }
+    Ok(outputs)
+}
