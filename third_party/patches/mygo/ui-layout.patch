diff --git a/ui/onesub_menu_tester.go b/ui/onesub_menu_tester.go
new file mode 100644
--- /dev/null
+++ b/ui/onesub_menu_tester.go
@@ -0,0 +1,83 @@
+package ui
+
+import "fmt"
+
+// MenuBase-backed component kits do not create platform.Menu objects. Inspect
+// their real menu nodes and exercise their keyboard input, including scrolling,
+// instead of calling an application's command callbacks from the test driver.
+func (t *Tester) baseMenuItems() []*node {
+	var menu *node
+	var find func(*node)
+	find = func(n *node) {
+		if n == nil || menu != nil || n.flags&flagInert != 0 {
+			return
+		}
+		if n.role == RoleMenu && n.widget == "Menu" {
+			menu = n
+			return
+		}
+		for ch := n.first; ch != nil; ch = ch.next {
+			find(ch)
+		}
+	}
+	find(t.rt.c.overlay)
+	var items []*node
+	var walk func(*node)
+	walk = func(n *node) {
+		if n == nil || n.flags&flagInert != 0 {
+			return
+		}
+		switch n.role {
+		case RoleMenuItem, RoleMenuItemCheckBox, RoleMenuItemRadio, RoleSeparator:
+			items = append(items, n)
+			return
+		}
+		for ch := n.first; ch != nil; ch = ch.next {
+			walk(ch)
+		}
+	}
+	walk(menu)
+	return items
+}
+
+func (t *Tester) baseMenuLabels() []string {
+	items := t.baseMenuItems()
+	if len(items) == 0 {
+		return nil
+	}
+	labels := make([]string, len(items))
+	for i, item := range items {
+		labels[i] = menuItemName(item)
+		if item.role == RoleSeparator {
+			labels[i] = "-"
+		}
+	}
+	return labels
+}
+
+func (t *Tester) chooseBaseMenuItem(path []string) error {
+	if len(path) != 1 {
+		return fmt.Errorf("ui: a base menu needs one item label")
+	}
+	steps := 0
+	for _, item := range t.baseMenuItems() {
+		if item.role == RoleSeparator {
+			continue
+		}
+		if menuItemName(item) == path[0] {
+			if item.disabled() {
+				return fmt.Errorf("ui: the item %q is disabled", path[0])
+			}
+			t.Key(0, KeyHome)
+			for range steps {
+				t.Key(0, KeyDown)
+			}
+			t.Key(0, KeyEnter)
+			return nil
+		}
+		if !item.disabled() {
+			steps++
+		}
+	}
+	return fmt.Errorf("ui: the context menu has no item %q", path[0])
+}
