+	height := float32(s.heights.height(row))
+	switch align {
+	case Center:
+		y -= (e.st.h - height) / 2
+	case End:
+		y -= e.st.h - height - e.pad[2] - e.border[2]
+	default:
+		y -= float32(s.padTop)
+	}
