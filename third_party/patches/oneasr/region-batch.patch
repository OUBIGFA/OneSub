+#[test]
+fn region_batch_loads_once_and_preserves_independent_outputs() {
+    let run = Run::new("region_batch", false);
+    let second = run.app_root.join("second.wav");
+    write_master_wav(&second, 4.0);
+    let inputs: Vec<_> = [&run.input, &second]
+        .into_iter()
+        .map(|input| oneasr_core::BatchInput {
+            input: input.clone(),
+            media_name: input.file_name().unwrap().to_string_lossy().into_owned(),
+            export: ProcessExportOptions {
+                words_json: Some(input.with_extension("words.json")),
+                ..ProcessExportOptions::default()
+            },
+        })
+        .collect();
+    let provider = FakeProvider::new("你好世界。", tokens());
+    let mut progress = Vec::new();
+    let outputs = oneasr_core::process_media_batch_with_provider(
+        &inputs,
+        &run.settings,
+        &run.app_root,
+        &provider,
+        |region, total, update| progress.push((region, total, update.stage)),
+    )
+    .unwrap();
+    assert_eq!(outputs.len(), 2);
+    assert_eq!(
+        provider.log().entries(),
+        vec![
+            "asr.load",
+            "asr.transcribe",
+            "asr.transcribe",
+            "asr.drop",
+            "aligner.load",
+            "aligner.align",
+            "aligner.align",
+            "aligner.drop",
+        ]
+    );
+    let first_srt = std::fs::read_to_string(&outputs[0]).unwrap();
+    assert_eq!(first_srt, std::fs::read_to_string(&outputs[1]).unwrap());
+    for input in &inputs {
+        let words: serde_json::Value = serde_json::from_str(
+            &std::fs::read_to_string(input.export.words_json.as_ref().unwrap()).unwrap(),
+        )
+        .unwrap();
+        assert!(words["word_count"].as_u64().unwrap() > 0);
+        for word in words["words"].as_array().unwrap() {
+            assert!(word["start"].as_f64().unwrap() >= 0.0);
+            assert!(word["end"].as_f64().unwrap() <= 4.0);
+        }
+    }
+    assert!(progress.contains(&(2, 2, oneasr_core::AsrStage::Aligning)));
+}
