@@ -0,0 +1,38 @@
+package ui
+
+import "testing"
+
+// The chosen sidebar item draws the same with and without the focus.
+func TestOneSubSidebarChosenKeepsAccent(t *testing.T) {
+	selected := "b"
+	focus := true
+	tt := NewTester(func(c *Context) {
+		Row(c).Fill().Children(func() {
+			s := Sidebar(c, &selected, func() {
+				SidebarItem(c, "a", nil, "First")
+				SidebarItem(c, "b", nil, "Second")
+			})
+			if focus {
+				s.AutoFocus()
+			}
+			Button(c, "Elsewhere")
+		})
+	}, 320, 200)
+	tt.Frame()
+	tt.Frame()
+	focused := append([]byte{}, tt.Image().Pix...)
+	focus = false
+	if err := tt.Click("Elsewhere"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Frame()
+	r, _ := tt.Find("Second")
+	img := tt.Image()
+	at := func(pix []byte) [4]byte {
+		i := img.PixOffset(int(r.X)+2, int(r.Y+r.H/2))
+		return [4]byte{pix[i], pix[i+1], pix[i+2], pix[i+3]}
+	}
+	if at(focused) != at(img.Pix) {
+		t.Fatal("the chosen item changed with the focus", at(focused), at(img.Pix))
+	}
+}
