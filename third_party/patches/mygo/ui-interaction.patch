+// ScrollToAnimated glides a measured, nearby row to align. Call it from the
+// view after building the list. Distant or unmeasured targets use ScrollTo:
+// traversing thousands of unseen rows would hide the destination and depend
+// on estimated heights. Native ScrollState owns easing and reduced motion.
+func (s *ListState) ScrollToAnimated(row int, align Align, animation Animation) {
+	f := &s.frame
+	if f.c == nil || !f.c.rt.inFrame || f.frame != f.c.rt.frame || f.pass != f.c.rt.pass || !s.laidOut || row < s.first || row > s.last || s.Header != nil {
