+func TestOneSubEdgeScrollCanBeInterrupted(t *testing.T) {
+	var state ListState
+	jump, edge := 100, -1
+	animation := Animation{Duration: 420 * time.Millisecond, Ease: EaseOut}
+	tt := coreNewTester(func(c *context) {
+		coreTable(c, &state, []TableColumn{{Title: "Subtitle"}}, 300, func(row, col int) {
+			coreText(c, fmt.Sprint("Row ", row)).Height(float32(32 + row%3*12))
+		}).Fill()
+		if jump >= 0 {
+			state.ScrollTo(jump, Start)
+			jump = -1
+		}
+		if edge >= 0 {
+			state.ScrollToEdgeAnimated(edge == 1, animation)
+			edge = -1
+		}
+	}, 500, 400)
+	edge = 1
+	tt.Frame()
+	tt.Advance(80 * time.Millisecond)
+	tt.Scroll(250, 200, 0, -120)
+	if state.Scrolling() {
+		t.Fatal("wheel did not cancel the edge glide")
+	}
+	tt.Advance(time.Second)
+	if state.AtEnd() {
+		t.Fatal("cancelled edge glide restarted after the wheel")
+	}
+	edge = 0
+	tt.Frame()
+	tt.Advance(80 * time.Millisecond)
+	edge = 1
+	tt.Frame()
+	tt.Advance(time.Second)
+	if !state.AtEnd() || state.Scrolling() {
+		t.Fatal("opposite navigation retained a stale destination")
+	}
+	edge = 0
+	tt.Frame()
+	tt.Advance(80 * time.Millisecond)
+	jump = 120
+	tt.Frame()
+	tt.Advance(time.Second)
+	if first, _ := state.Visible(); first != 120 || state.Scrolling() {
+		t.Fatal("immediate row navigation did not cancel the edge glide", first)
+	}
+}
