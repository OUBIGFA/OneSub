* text=auto eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.png binary

# Subtitle fixtures retain upstream separators, including a final empty block.
third_party/skills/srt-subtitle-translator/evals/fixtures/* whitespace=-blank-at-eof

# Unified-diff context prefixes precede the Go source's tabs by design.
third_party/patches/mygo/*.patch whitespace=-space-before-tab
